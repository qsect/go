# ============================================================
# 装置车间综合协作平台 - Go 后端配置文件 (.env)
# 说明：纯 Go 后端配置。变量名沿用迁移前的命名，以保持既有部署与运维习惯
# ============================================================

APP_ENV=production
APP_DEBUG=false
APP_SECRET=change_this_to_your_random_secret_key

# Go 服务监听地址与端口
GO_LISTEN_ADDR=127.0.0.1:8080

# 静态与共享文件根目录（默认指向上级或同级 backend/public，用于共享文件与安装包下载）
PUBLIC_ROOT=../backend/public
STORAGE_ROOT=./storage

# 渐进式迁移过渡配置（已移除）：
# 原 PHP_FALLBACK_URL 用于把未迁移接口反代至旧 PHP 后端。
# PHP 后端已下线，该兜底逻辑已从 internal/router/router.go 中删除，勿再配置。

# 本地业务主数据库 (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vite
DB_USER=vite
DB_PASS=your_db_password

# 外部数据源 (SQL Server，选配)
SQLSRV_HOST=127.0.0.1
SQLSRV_PORT=1433
SQLSRV_DB=your_db_name
SQLSRV_USER=your_db_user
SQLSRV_PASS=your_db_password

# 外部生产排产/追踪库 (MES MySQL，选配)
MES_DB_HOST=127.0.0.1
MES_DB_PORT=3306
MES_DB_NAME=your_db_name
MES_DB_USER=your_db_user
MES_DB_PASS=your_db_password

# 外部 CEM 质量追溯系统凭据
CEM_HOST=http://cem.ieslab.cn
CEM_USER=your_cem_user
CEM_PASS=your_cem_password

# 允许跨域的前端来源（逗号分隔，留空则默认允许 https://ieslab.com,https://www.ieslab.com）
CORS_ORIGINS=https://ieslab.com,https://www.ieslab.com

# BarTender 标签打印服务 API 地址
PRINT_API_URL=http://127.0.0.1:8080/api/print

# 登录失败限速：窗口内最大失败次数 / 锁定窗口（秒）
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_WINDOW=600

# 会话空闲超时（秒），默认 8 小时 (28800)
SESSION_IDLE_TIMEOUT=28800

# 会话 Cookie 名称（默认 PHPSESSID 以无缝兼容原前端与 Nginx 配置）
SESSION_COOKIE_NAME=PHPSESSID

# 导出 / 工具箱转换接口限流（L5）：窗口内最大次数 / 窗口（秒）
RATE_LIMIT_ENABLED=1
RATE_CONVERT_MAX=3
RATE_CONVERT_WINDOW=60
RATE_EXPORT_MAX=30
RATE_EXPORT_WINDOW=60
